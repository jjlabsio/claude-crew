// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`renderPrompt > renders a planner prompt with capability, inputs, instructions and success gate 1`] = `
"# Planner

## Capability
workspaceAccess: read-only
canAskUser: false
canRequestAgent: true
canUseShell: false
canReturnCrewArtifact: true

## Inputs
### .crew/plans/task-123/spec.md
# Spec
Build the runner render command.
### .crew/plans/task-123/analysis.md
# Analysis
Keep provider dispatch out of rendering.
### Denied Inputs
- .crew/plans/{task-id}/brief.md

## Outputs
[
  {
    "type": "artifact",
    "target": ".crew/plans/{task-id}/plan.md"
  }
]

## Instructions
Create a concrete implementation plan from the provided spec and analysis.

## Success Gate
The plan is actionable and names the files to change.

## AgentResult Contract
Return exactly one final AgentResult JSON object wrapped in these tags:

\`\`\`text
<crew-agent-result>
{
  "status": "complete | blocked_on_user | needs_agent | needs_tool | failed",
  "artifact": "full Markdown content of the artifact",
  "questions": [],
  "requests": [],
  "summary": "short summary",
  "error": null
}
</crew-agent-result>
\`\`\`

Rules:
- The wrapper tags are mandatory.
- The JSON inside the tags must be valid JSON.
- Use complete when the requested artifact is ready.
- Use blocked_on_user only with a non-empty questions array.
- Use needs_agent or needs_tool only with a non-empty requests array.
- Use failed with an error string when the task cannot continue.
- Do NOT write the artifact file yourself. Instead, put the full Markdown content into the artifact field as a string. The runner will validate and save it to the target path.
"
`;
